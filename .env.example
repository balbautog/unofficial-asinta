# Supabase — required for the app to run against a live project.
# Copy to .env.local (or .env) and fill in the values from
# Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Groq AI key used by /api/ai/categorize (server-side only).
GROQ_API_KEY=

# Optional: PhilSMS gateway key used by /api/sms/send (server-side only).
# When absent, SMS messages are logged to sms_logs in simulation mode.
PHILSMS_API_KEY=
