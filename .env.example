# Supabase — required for the app to run against a live project.
# Copy to .env.local (or .env) and fill in the values from
# Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Groq AI key used by /api/ai/categorize (server-side only).
GROQ_API_KEY=

# SMTP — server-side only
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

EMAIL_FROM_NAME=Asinta Architects
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
FIRM_CONTACT_NUMBER=

# Existing or required integrations
PHILSMS_API_KEY=

# Trusted scheduled operations
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Must remain disabled by default
AUTOMATIC_REMINDERS_ENABLED=false
